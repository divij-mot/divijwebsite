# Copy to .env for local development, or set these in the Vercel project.
# Values never belong in source control.

# ---------------------------------------------------------------------------
# Existing site
# ---------------------------------------------------------------------------

# FastAPI signalling server for the P2P share tool.
VITE_BACKEND_URL=

# Powers the AI page generator on the catch-all route.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Builder: required
# ---------------------------------------------------------------------------

# Mosaic Sandbox API key (msk_live_...). The control plane uses it server-side only;
# it is never sent to the browser.
MOSAIC_API_KEY=

# Signs the beta session cookie and derives the privacy-preserving safety identifier
# sent to OpenAI. At least 32 characters. Rotating it signs everyone out.
#   openssl rand -base64 48
BUILDER_SESSION_SECRET=

# Comma-separated invite codes. Compared by hash; the plaintext is never stored.
# With Redis configured you can instead manage codes at runtime and revoke them.
BUILDER_INVITE_CODES=

# ---------------------------------------------------------------------------
# Builder: runtime image
# ---------------------------------------------------------------------------

# Name of the Mosaic environment built from runtime/Dockerfile. Defaults to this value.
#   node scripts/mosaic-build-environment.mjs --image <registry>/<image>:<tag> --verify
MOSAIC_ENVIRONMENT=divij-builder-runtime

# Recorded for provenance. Registry credentials are needed only when building the
# environment, never at runtime, because Mosaic unpacks the image once and keeps it.
MOSAIC_RUNTIME_DIGEST=

# Override only for a non-default Mosaic deployment.
# MOSAIC_API_URL=https://sandbox.mosaicos.com

# ---------------------------------------------------------------------------
# Builder: optional
# ---------------------------------------------------------------------------

# Upstash Redis. Optional, but without it quotas enforce nothing: the store falls back to
# per-instance memory and every serverless invocation counts from zero. The invite gate and
# the one-sandbox-per-session rule still hold. Workspace leases never need it -- those are
# recoverable from the Mosaic sandbox's own labels.
#
# Easiest setup:  vercel integration add upstash/upstash-kv
#
# That provisions Redis and sets KV_REST_API_URL and KV_REST_API_TOKEN on the project,
# which the store reads as an alias for the UPSTASH_ names below. It also writes them to
# .env.local -- but `vercel dev` reads .env, not .env.local, so copy those two values here
# as well or the local control plane will silently run without a durable store.
# `node scripts/check-store.mjs` tells you which driver is actually active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cloudflare Turnstile on the invite form. Free, and skipped entirely when unset.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Extra origins allowed to call /api/builder/*, beyond the deployment's own host.
# Comma-separated, host only. Usually needed just for local development.
# BUILDER_ALLOWED_ORIGINS=localhost:3000

# Optional override for the iframe's origin. By default the builder pairs localhost with
# 127.0.0.1, and a custom domain with the deployment's *.vercel.app host.
# PREVIEW_FRAME_ORIGIN=https://divij-website.vercel.app

# Set to 1 to refuse all builder traffic without redeploying.
# BUILDER_DISABLED=0
